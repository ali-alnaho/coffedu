// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// state enum
enum EnrollmentStatus {
  ACTIVE
  REPEATED
  GRADUATED
  WITHDRAWN
}

enum SchoolStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// Role enum
enum Role {
  PLATFORM_OWNER
  SCHOOL_ADMIN
  STUDENT
  MANAGER
  TEACHER
}

model School {
  id      String  @id @default(cuid())
  name    String
  code    String  @unique
  phone   String?
  email   String?
  address String?

  status SchoolStatus @default(PENDING_ACTIVATION)

  // Dates
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations 
  users                   User[]
  teachers                Teacher[]
  students                Student[]
  academicYears           AcademicYear[]
  gradeLevels             GradeLevel[]
  studentEnrollments      StudentEnrollment[]
  subjects                Subject[]
  enrollmentSubjectGrades EnrollmentSubjectGrade[]
}

// User table 
model User {
  // [Name]  [Type]  [Attributes]
  // Primary key
  id String @id @default(cuid())

  // Data fields 
  firstName  String?
  familyName String?
  email      String? @unique
  userName   String  @unique
  password   String

  //Dates 
  createdAt DateTime @default(now())

  // Relations 
  role Role

  // FK + @unique ==> relation one to one with student model
  //  @unique ==> only one row can have that FK value
  studentId String?  @unique
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // relation one to one with Teacher model
  teacherId String?  @unique
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  school   School? @relation(fields: [schoolId], references: [id])
  schoolId String?
}

// teacher Table 
model Teacher {
  id String @id @default(cuid())

  firstName        String
  fatherName       String
  grandName        String
  theFourthName    String?
  familyName       String?
  motherFirstName  String
  motherFatherName String
  dateOfBirth      DateTime @db.Date

  // more information 
  mobileNumber                String?
  academicQualification       String?
  specialization              String?
  nameOfUniversity            String?
  yearOfGraduation            DateTime? @db.Date
  dateOfFirstCommencement     DateTime? @db.Date
  ministerialAppointmentOrder DateTime? @db.Date

  // Dates
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations 
  user User?

  school   School @relation(fields: [schoolId], references: [id])
  schoolId String
}

// student table
model Student {
  // Primary key
  id String @id @default(cuid())

  // Data fields
  firstName        String
  fatherName       String
  grandName        String
  theFourthName    String?
  familyName       String?
  motherFirstName  String
  motherFatherName String
  dateOfBirth      DateTime @db.Date

  // Dates
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  studentEnrollments StudentEnrollment[]
  user               User?

  school   School @relation(fields: [schoolId], references: [id])
  schoolId String
}

// acadimic_years model 
model AcademicYear {
  // Primary key
  id        String   @id @default(cuid())
  year      String // e.g. "2024-2025" 
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  // Date 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  studentEnrollments StudentEnrollment[]

  school   School @relation(fields: [schoolId], references: [id])
  schoolId String

  @@unique([schoolId, year])
}

model GradeLevel {
  // Primary Key
  id    String @id @default(cuid())
  level Int // e.g. level = 1
  name  String // e.g. name = "First Grade"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  studentEnrollments StudentEnrollment[]
  subjects           Subject[]

  school   School @relation(fields: [schoolId], references: [id])
  schoolId String

  @@unique([schoolId, level])
}

model Subject {
  id          String @id @default(cuid())
  subjectName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollmentSubjectGrades EnrollmentSubjectGrade[]

  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id])
  gradeLevelId String

  school   School @relation(fields: [schoolId], references: [id])
  schoolId String

  @@unique([schoolId, gradeLevelId, subjectName])
}

model EnrollmentSubjectGrade {
  id         String @id @default(cuid())
  finalScore Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject   Subject @relation(fields: [subjectId], references: [id])
  subjectId String

  studentEnrollment   StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id])
  studentEnrollmentId String

  school   School @relation(fields: [schoolId], references: [id])
  schoolId String

  @@unique([studentEnrollmentId, subjectId])
}

model StudentEnrollment {
  id         String @id @default(cuid())
  // relation field 
  studentId  String
  gradeId    String
  academicId String

  status EnrollmentStatus @default(ACTIVE)

  // relations 
  enrollmentSubjectGrades EnrollmentSubjectGrade[]

  student      Student      @relation(fields: [studentId], references: [id])
  gradeLevel   GradeLevel   @relation(fields: [gradeId], references: [id])
  academicYear AcademicYear @relation(fields: [academicId], references: [id])

  school   School @relation(fields: [schoolId], references: [id])
  schoolId String

  @@unique([studentId, academicId])
}

//             ┌──────────────┐
//             │     User     │
//             ├──────────────┤
//             │ id (PK)      │
//             │ firstName    │
//             │ familyName   │
//             │ email        │
//             │ userName     │
//             │ password     │
//             │ role         │
//             │ createdAt    │
//             └──────────────┘
//                     │
//                     │ (future relation possible)
//                     │
//                     ▼
//             ┌──────────────┐
//             │   Student    │
//             ├──────────────┤
//             │ id (PK)      │
//             │ firstName    │
//             │ fatherName   │
//             │ ...          │
//             └──────────────┘
//                     │
//                     │ 1 → many
//                     ▼
//     ┌────────────────────────────────┐
//     │     StudentEnrollments         │
//     ├────────────────────────────────┤
//     │ id (PK)                        │
//     │ studentId (FK) ─────────────── ┼────────────────┐
//     │ gradeId (FK)                   │                │
//     │ academicId (FK)                │                │
//     │ status                         │                │
//     └────────────────────────────────┘                │
//              │                    │                   │
//              │                    │                   │
//              ▼                    ▼                   ▼
//  ┌──────────────────┐  ┌──────────────────┐  ┌────────────────────┐
//  │  GradeLevels     │  │ AcademicYears    │  │     Student        │
//  ├──────────────────┤  ├──────────────────┤  ├────────────────────┤
//  │ id (PK)          │  │ id (PK)          │  │ id (PK)            │
//  │ level            │  │ year             │  │ ...                │
//  │ name             │  │ startDate        │  │                    │
//  └──────────────────┘  │ endDate          │  └────────────────────┘
//                        │ isActive         │
//                        └──────────────────┘

/**
 * Why StudentEnrollment exists:
 * - Keeps the student's academic history.
 * - Separates student identity from academic records.
 * - Creates a new enrollment every academic year instead of updating old data.
 * - Supports promotion, repeating a grade, and class transfers.
 * - Prevents losing historical academic data.
 * - Serves as the main reference for attendance, grades, exams, reports, and exam seating.
 * - Reflects the real-world process where a student enrolls each academic year.
 */

/**
 * StudentEnrollment Rules
 * ✔ CREATE
 * - Create the first enrollment when registering a student.
 * - Create a new enrollment when promoting a student.
 * - Create a new enrollment when repeating a grade.
 * - Create a new enrollment whenever a new academic year begins.
 * ✔ UPDATE
 * - status
 * - notes
 * - Any future administrative fields that do not change the enrollment identity.
 * ✖ NEVER UPDATE
 * - studentId
 * - academicId
 * - gradeId
 * Changing any of these fields means creating a new StudentEnrollment record.
 * ✖ NEVER DELETE
 * StudentEnrollment records are permanent historical records.
 * Deleting them would break the student's academic history and may invalidate
 * attendance, grades, exams, reports, and other related data.
 */
